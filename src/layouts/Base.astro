---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import BarraMobile from '../components/global/BarraMobile.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  hrefConsultoria?: string; // para onde a barra do celular leva (padrão: /consultoria-gratuita)
  mensagemWhatsApp?: string;
}
const { title, description, noindex = false, hrefConsultoria, mensagemWhatsApp } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#empresa`,
  name: 'Otimizo',
  legalName: site.razaoSocial,
  description: 'Agência de marketing e vendas para escritórios de contabilidade, advocacia e pequenas e médias empresas de todo o Brasil.',
  url: site.url,
  logo: `${site.url}/img/logo-otimizo.svg`,
  telephone: '+55 41 99984-2667',
  email: site.email,
  taxID: site.cnpj,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.endereco.rua,
    addressLocality: site.endereco.cidade,
    addressRegion: site.endereco.uf,
    postalCode: site.endereco.cep,
    addressCountry: 'BR',
  },
  areaServed: 'BR',
  sameAs: [site.instagram, site.linkedin],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Otimizo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preload" href="/fonts/sora.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline set:html={JSON.stringify(schema)} type="application/ld+json" />

    <!-- Camada de dados para GTM, GA4, Pixel da Meta e Google Ads -->
    <script is:inline>window.dataLayer = window.dataLayer || [];</script>
    {site.gtmId && (
      <script is:inline define:vars={{ id: site.gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
      </script>
    )}
  </head>
  <body>
    {site.gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="GTM"></iframe></noscript>
    )}
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-full focus:bg-tinta focus:px-5 focus:py-3 focus:text-white">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <BarraMobile hrefConsultoria={hrefConsultoria} mensagem={mensagemWhatsApp} />

    <script>
      // Envia cliques de CTA para o dataLayer (usado pelo GTM)
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-evento]');
        if (!el) return;
        (window as any).dataLayer.push({
          event: el.dataset.evento,
          pagina: location.pathname,
          texto: el.textContent?.trim().replace(/\s+/g, ' '),
        });
      });
    </script>
  </body>
</html>
