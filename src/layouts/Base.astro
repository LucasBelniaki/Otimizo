---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import BarraMobile from '../components/global/BarraMobile.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  hrefConsultoria?: string; // para onde a barra do celular leva (padrão: /consultoria-gratuita)
  mensagemWhatsApp?: string;
  ogType?: 'website' | 'article';
}
const { title, description, noindex = false, hrefConsultoria, mensagemWhatsApp, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#empresa`,
  name: 'Otimizo',
  legalName: site.razaoSocial,
  description: 'Agência de marketing e vendas para empresas e empreendedores de todo o Brasil.',
  url: site.url,
  logo: `${site.url}/img/logo-otimizo.svg`,
  telephone: '+55 41 99984-2667',
  email: site.email,
  taxID: site.cnpj,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.endereco.rua,
    addressLocality: site.endereco.cidade,
    addressRegion: site.endereco.uf,
    postalCode: site.endereco.cep,
    addressCountry: 'BR',
  },
  openingHours: 'Mo-Fr 08:00-18:00',
  areaServed: 'BR',
  sameAs: [site.instagram, site.linkedin],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Otimizo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preload" href="/fonts/sora.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline set:html={JSON.stringify(schema)} type="application/ld+json" />
    <slot name="head" />

    <!-- Camada de dados para GTM, GA4, Pixel da Meta e Google Ads -->
    <script is:inline>window.dataLayer = window.dataLayer || [];</script>
    {site.gtmId && (
      <script is:inline define:vars={{ id: site.gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
      </script>
    )}
  </head>
  <body>
    {site.gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="GTM"></iframe></noscript>
    )}
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-full focus:bg-tinta focus:px-5 focus:py-3 focus:text-white">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <BarraMobile hrefConsultoria={hrefConsultoria} mensagem={mensagemWhatsApp} />

    <script>
      import { iniciarRefracao } from '../lib/refracao';
      const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Refração do vidro líquido nas bordas (Chromium), depois que a página carrega
      ('requestIdleCallback' in window ? (window as any).requestIdleCallback : setTimeout)(iniciarRefracao);

      // Revelação suave ao rolar (só liga com JS e movimento permitido)
      if (!semMovimento && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('anima');
        const io = new IntersectionObserver((itens) => {
          itens.forEach((i) => {
            if (i.isIntersecting) { i.target.classList.add('visivel'); io.unobserve(i.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        document.querySelectorAll('[data-revelar]').forEach((el) => io.observe(el));
      }

      // Luz que acompanha o ponteiro nos cards
      document.addEventListener('pointermove', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('.luz');
        if (!el) return;
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${e.clientX - r.left}px`);
        el.style.setProperty('--my', `${e.clientY - r.top}px`);
      }, { passive: true });

      // Contagem dos números quando aparecem na tela
      const contadores = document.querySelectorAll<HTMLElement>('[data-contar]');
      if (!semMovimento && contadores.length && 'IntersectionObserver' in window) {
        const ioN = new IntersectionObserver((itens) => {
          itens.forEach((i) => {
            if (!i.isIntersecting) return;
            ioN.unobserve(i.target);
            const el = i.target as HTMLElement;
            const alvo = Number(el.dataset.contar);
            const t0 = performance.now();
            const passo = (t: number) => {
              const p = Math.min(1, (t - t0) / 1400);
              el.textContent = String(Math.round(alvo * (1 - Math.pow(1 - p, 3))));
              if (p < 1) requestAnimationFrame(passo);
            };
            requestAnimationFrame(passo);
          });
        }, { threshold: 0.4 });
        contadores.forEach((el) => ioN.observe(el));
      }

      // Envia cliques de CTA para o dataLayer (usado pelo GTM)
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-evento]');
        if (!el) return;
        (window as any).dataLayer.push({
          event: el.dataset.evento,
          pagina: location.pathname,
          texto: el.textContent?.trim().replace(/\s+/g, ' '),
        });
      });
    </script>
  </body>
</html>
