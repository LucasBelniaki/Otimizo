---
// Chamada final com os dois botões (sem formulário). Usada em Serviços, Sobre e Projetos sociais.
import Botao from '../ui/Botao.astro';
import Microcopy from '../ui/Microcopy.astro';
interface Props { titulo: string; texto: string; mensagem?: string }
const { titulo, texto, mensagem } = Astro.props;
---
<section class="escuro granulado relative overflow-hidden bg-tinta text-white" style="--grao:.2" aria-labelledby="chamada-botoes-titulo">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="deriva-1 absolute -left-40 top-1/4 size-[40rem] rounded-full bg-[radial-gradient(closest-side,rgba(91,60,240,.45),transparent)]"></div>
    <div class="deriva-2 absolute -right-32 -top-40 size-[34rem] rounded-full bg-[radial-gradient(closest-side,rgba(31,94,255,.3),transparent)]"></div>
    <div class="grade-fundo absolute inset-0 opacity-[0.07] [--cor-grade:#fff] [mask-image:radial-gradient(70%_70%_at_50%_50%,#000,transparent)]"></div>
    <img src="/img/simbolo-branco.svg" alt="" width="700" height="515" loading="lazy" class="absolute -bottom-16 -right-20 w-[28rem] opacity-[0.06] lg:w-[40rem]" />
  </div>
  <div class="container-site secao grid max-w-4xl justify-items-center gap-7 text-center" data-revelar>
    <h2 id="chamada-botoes-titulo" class="titulo-secao !text-white">{titulo}</h2>
    <p class="texto-secao mx-auto">{texto}</p>
    <div class="flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
      <Botao href="/consultoria-gratuita" />
      <Botao variante="whatsapp" mensagem={mensagem} />
    </div>
    <Microcopy class="justify-center" />
  </div>
</section>
