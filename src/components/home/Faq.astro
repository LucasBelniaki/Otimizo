---
import Icone from '../ui/Icone.astro';
import { copy } from '../../lib/texto';
interface Props {
  perguntas: { p: string; r: string }[];
  titulo?: string;
  class?: string;
}
const { perguntas, titulo = 'Perguntas frequentes', class: classe = '' } = Astro.props;
---
<section class:list={['secao', classe]} aria-labelledby="faq-titulo">
  <div class="container-site grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 id="faq-titulo" class="titulo-secao">{titulo}</h2>
    </div>
    <div class="grid border-t border-linha">
      {perguntas.map((item) => (
        <details class="group border-b border-linha">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left font-display text-[1.0625rem] font-semibold tracking-[-0.015em] marker:hidden lg:py-6 lg:text-lg [&::-webkit-details-marker]:hidden">
            <span>{item.p}</span>
            <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full border border-linha transition-transform duration-200 group-open:rotate-45 group-open:border-roxo group-open:bg-lavanda group-open:text-roxo">
              <Icone nome="mais" class="size-4" />
            </span>
          </summary>
          <p class="max-w-[62ch] pb-6 pr-12 leading-relaxed text-cinza" set:html={copy(item.r)} />
        </details>
      ))}
    </div>
  </div>
</section>
