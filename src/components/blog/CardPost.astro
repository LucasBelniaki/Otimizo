---
// Card de post (listagem do blog e página Obrigado).
import type { CollectionEntry } from 'astro:content';
import Icone from '../ui/Icone.astro';
import CapaPost from './CapaPost.astro';
import { dataPorExtenso } from '../../data/blog';

interface Props { post: CollectionEntry<'blog'>; destaque?: boolean; titulo?: 'h2' | 'h3' }
const { post, destaque = false, titulo: Titulo = 'h2' } = Astro.props;
const { titulo, resumo, categoria, data, autor } = post.data;
---
<a
  href={`/blog/${post.id}/`}
  class:list={['luz group grid h-full overflow-hidden rounded-[var(--radius-card)] border border-[#ebe7fa] bg-white transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:border-[#cfc8f5] hover:shadow-[0_30px_60px_-34px_rgba(91,60,240,.45)]', destaque ? 'lg:grid-cols-[1.15fr_1fr]' : 'grid-rows-[auto_1fr]']}
>
  <CapaPost categoria={categoria} class={destaque ? 'aspect-[16/10] lg:aspect-auto lg:min-h-[22rem]' : 'aspect-[16/10]'} />
  <div class:list={['grid content-start gap-3 p-6', destaque ? 'lg:content-center lg:gap-4 lg:p-10' : 'lg:p-7']}>
    <p class="font-mono text-xs uppercase tracking-[0.08em] text-cinza"><time datetime={data.toISOString().slice(0, 10)}>{dataPorExtenso(data)}</time> · {autor}</p>
    <Titulo class:list={['transition-colors group-hover:text-roxo', destaque ? 'text-2xl lg:text-[2rem] lg:leading-tight' : 'text-xl lg:text-[1.375rem]']}>{titulo}</Titulo>
    <p class="leading-relaxed text-cinza">{resumo}</p>
    <span class="mt-2 grid size-10 place-items-center rounded-full border border-linha text-roxo transition-colors duration-300 group-hover:border-roxo group-hover:bg-roxo group-hover:text-white" aria-hidden="true"><Icone nome="seta" class="size-4" /></span>
  </div>
</a>
