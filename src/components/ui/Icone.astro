---
// Ícones de linha usados no site. Decorativos por padrão (aria-hidden).
interface Props {
  nome: 'whatsapp' | 'seta' | 'chevron' | 'menu' | 'fechar' | 'mais' | 'calculadora' | 'balanca' | 'grade' | 'relatorio' | 'pessoa' | 'alvo' | 'chat' | 'funil' | 'elo' | 'coracao' | 'aspas' | 'pin' | 'x';
  class?: string;
}
const { nome, class: classe = 'size-5' } = Astro.props;
---
{nome === 'whatsapp' ? (
  <svg class={classe} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2.2a9.8 9.8 0 0 0-8.4 14.9L2.2 21.8l4.8-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.8a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.8.8-2.8-.2-.3A8 8 0 1 1 12 20Zm4.4-5.9c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.6.3 2.7 2.7 0 0 0-.9 2c0 1.2.9 2.3 1 2.5.1.2 1.7 2.6 4.2 3.7 1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.5-.5Z"/></svg>
) : (
  <svg class={classe} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    {nome === 'seta' && <path d="M5 12h14M13 6l6 6-6 6" />}
    {nome === 'chevron' && <path d="m6 9 6 6 6-6" />}
    {nome === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
    {nome === 'fechar' && <path d="M6 6l12 12M18 6 6 18" />}
    {nome === 'mais' && <path d="M12 5v14M5 12h14" />}
    {nome === 'x' && <path d="M7 7l10 10M17 7 7 17" />}
    {nome === 'calculadora' && <><rect x="5" y="3" width="14" height="18" rx="2.5" /><path d="M8.5 7h7M8.5 11h.01M12 11h.01M15.5 11h.01M8.5 14.5h.01M12 14.5h.01M15.5 14.5v3M8.5 17.5h.01M12 17.5h.01" /></>}
    {nome === 'balanca' && <path d="M12 4v16M8 20h8M5 7h14M5 7l-2.5 6a3 3 0 0 0 5 0L5 7Zm14 0-2.5 6a3 3 0 0 0 5 0L19 7ZM12 4a1 1 0 1 0 0 .01" />}
    {nome === 'grade' && <><rect x="4" y="4" width="7" height="7" rx="1.5" /><rect x="13" y="4" width="7" height="7" rx="1.5" /><rect x="4" y="13" width="7" height="7" rx="1.5" /><rect x="13" y="13" width="7" height="7" rx="3.5" /></>}
    {nome === 'relatorio' && <><path d="M4 20h16" /><path d="M7 16v-5M12 16V8M17 16v-8" /></>}
    {nome === 'pessoa' && <><circle cx="12" cy="8" r="3.5" /><path d="M5 20a7 7 0 0 1 14 0" /></>}
    {nome === 'alvo' && <><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="4" /><circle cx="12" cy="12" r=".6" /></>}
    {nome === 'chat' && <path d="M5 18.5V6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v7a2.5 2.5 0 0 1-2.5 2.5H9l-4 2.5ZM8.5 9h7M8.5 12.5h4" />}
    {nome === 'funil' && <path d="M4 5h16l-6 7.5V19l-4 1.5v-8L4 5Z" />}
    {nome === 'elo' && <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />}
    {nome === 'coracao' && <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" />}
    {nome === 'pin' && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></>}
    {nome === 'aspas' && <path d="M9 7H6.5A1.5 1.5 0 0 0 5 8.5V12h4V7Zm0 5c0 3-1.5 4.5-4 5M19 7h-2.5A1.5 1.5 0 0 0 15 8.5V12h4V7Zm0 5c0 3-1.5 4.5-4 5" />}
  </svg>
)}
